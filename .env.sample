# LLM: any OpenAI-compatible endpoint. Defaults to the hackathon's LLM proxy.
# To use OpenAI directly: LLM_API_BASE=https://api.openai.com/v1 and your own key.
LLM_API_BASE=https://llm.hackathon.ethz.ch
# On your team VM, this is prefilled with a shared key
LLM_API_KEY=<your-api-key>
LLM_MODEL=openrouter/deepseek/deepseek-v4.1-flash
