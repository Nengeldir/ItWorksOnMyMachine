{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog && tsc -b && vite build && node scripts/bundle-check.mjs",
    "catalog": "node ../shared/catalog/check.mjs && node ../shared/catalog/types.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/*.test.mjs",
    "bundle:accept": "node scripts/bundle-check.mjs --accept"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "lil-gui": "^0.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
